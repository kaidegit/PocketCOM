{
  "name": "pocketcom",
  "version": "0.1.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "bun test test/",
    "typecheck": "tsc --noEmit",
    "check": "bun vendor/pocketjs/tools/pocket.ts check --target macos-app --manifest app/pocket.json --project-root .",
    "build": "bun vendor/pocketjs/tools/pocket.ts compile --target macos-app --manifest app/pocket.json --project-root .",
    "dev": "npm run build && node tools/dev.mjs",
    "install:macos": "npm run build && cargo build --locked --release --manifest-path host/macos/Cargo.toml && tools/package-macos.sh && tools/install-macos.sh",
    "check:aic": "bun host/rtthread/aic.ts check",
    "package:aic": "bun host/rtthread/aic.ts package",
    "build:aic": "bun host/rtthread/aic.ts build",
    "flash:aic": "bun host/rtthread/aic.ts flash"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kaidegit/PocketCOM.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/kaidegit/PocketCOM/issues"
  },
  "homepage": "https://github.com/kaidegit/PocketCOM#readme",
  "private": "true",
  "devDependencies": {
    "@emnapi/core": "^1.11.3",
    "@emnapi/runtime": "^1.11.3",
    "@pocketjs/framework": "file:vendor/pocketjs",
    "bun-types": "^1.4.1",
    "typescript": "^7.0.2",
    "vue": "3.6.0-rc.1",
    "vue-jsx-vapor": "3.2.19"
  }
}

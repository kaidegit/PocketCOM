      "terminal": false,
      "mcp.server": true,
      "transport.serial": true,
      "transport.tcp-client": true,
      "transport.tcp-server": true,
      "transport.udp": true,
      "transport.websocket": true
    },
    "mcp-off": {
      "terminal": false,
      "mcp.server": false,
      "transport.serial": true,
      "transport.tcp-client": true,
      "transport.tcp-server": true,
      "transport.udp": true,
      "transport.websocket": true

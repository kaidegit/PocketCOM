    "transport-all": {
      "terminal": false,
      "mcp.server": false,
      "transport.serial": true,
      "transport.tcp-client": true,
      "transport.tcp-server": true,
      "transport.udp": true,
      "transport.websocket": true
    },
    "transport-serial": {
      "terminal": false,
      "mcp.server": false,
      "transport.serial": true,
      "transport.tcp-client": false,
      "transport.tcp-server": false,
      "transport.udp": false,
      "transport.websocket": false
    }
  }
}

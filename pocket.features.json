        "mode",
        "panel.mode",
        "settings.scrollbackLines"
      ]
    },
    "transport.serial": {
      "status": "implemented",
      "modules": [
        "bridge/transport-serial.ts"
      ],
      "i18n": [
        "conn.serial",
        "conn.port",
        "conn.noPorts",
        "conn.noPortSelected",
        "conn.baudRate",
        "conn.baudInvalid",
        "conn.custom",
        "conn.dataBits",
        "conn.parity",
        "conn.stopBits",
        "conn.flowControl",
        "conn.dtr",
        "conn.rts",
        "conn.parityOpt",
        "conn.stopBitsOpt",
        "conn.flow"
      ]
